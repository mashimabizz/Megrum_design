{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:preview:clear": "eas build --platform ios --profile preview --clear-cache",
    "config:ios:preview": "APP_VARIANT=preview expo config --type public",
    "export:ios:preview": "NODE_PATH=./node_modules APP_VARIANT=preview expo export:embed --eager --platform ios --dev false",
    "update:ios:preview": "NODE_PATH=./node_modules APP_VARIANT=preview eas update --channel preview --platform ios",
    "build:ios:sim": "eas build --platform ios --profile development-simulator",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@supabase/supabase-js": "2.105.4",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-gl": "~16.0.10",
    "expo-glass-effect": "~0.1.10",
    "expo-iap": "^4.3.1",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-updates": "~29.0.17",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/three": "^0.184.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "uuid": "^11.1.1"
  },
  "private": true
}
