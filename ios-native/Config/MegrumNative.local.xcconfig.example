// Copy this file to MegrumNative.local.xcconfig and fill the values.
// The local file is gitignored, so do not commit real keys.
// Use https:/$()/... instead of https://... because // starts an xcconfig comment.

MEGRUM_SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
MEGRUM_SUPABASE_PUBLISHABLE_KEY = YOUR_SUPABASE_PUBLISHABLE_KEY
MEGRUM_SUPABASE_VIEWER_ID = 00000000-0000-0000-0000-000000000000
MEGRUM_URL_SCHEME = megrum-preview
MEGRUM_AUTH_EMAIL_REDIRECT_URL = https:/$()/megrum.jp/auth/callback?next=mobile&scheme=$(MEGRUM_URL_SCHEME)
MEGRUM_AUTH_OAUTH_AUTHORIZE_URL = https:/$()/megrum.jp/auth/oauth/authorize
MEGRUM_PLUS_IAP_ENABLED = NO

// Ads are disabled in the checked-in release-safe defaults.
// Fill these only for local AdMob verification builds.
MEGRUM_ADS_ENABLED = NO
MEGRUM_ADMOB_APP_ID =
MEGRUM_ADMOB_TEST_ADS_ENABLED = NO
MEGRUM_ADMOB_TEST_BANNER_UNIT_ID =
MEGRUM_ADMOB_TEST_NATIVE_UNIT_ID =
MEGRUM_AD_PREVIEW_VIEWER_IDS =
MEGRUM_ADMOB_SEARCH_NATIVE_UNIT_ID =
MEGRUM_ADMOB_TRADES_BANNER_UNIT_ID =
