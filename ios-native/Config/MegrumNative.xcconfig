// Checked-in defaults for the native iOS app.
// Copy MegrumNative.local.xcconfig.example to MegrumNative.local.xcconfig
// when you want a local live-data build. The local file is gitignored.

MEGRUM_SUPABASE_URL =
MEGRUM_SUPABASE_PUBLISHABLE_KEY =
MEGRUM_SUPABASE_VIEWER_ID =
MEGRUM_URL_SCHEME = megrum-preview
MEGRUM_AUTH_EMAIL_REDIRECT_URL = https:/$()/megrum.jp/auth/callback?next=mobile&scheme=$(MEGRUM_URL_SCHEME)
MEGRUM_AUTH_OAUTH_AUTHORIZE_URL = https:/$()/megrum.jp/auth/oauth/authorize
MEGRUM_PLUS_IAP_ENABLED = NO
// プレビュー版はGoogleテスト広告で表示位置・レイアウトを確認する（iter1226.301）。
// 本番リリース時は TEST_ADS_ENABLED を NO に戻し、各ユニットIDを実IDへ差し替える。
MEGRUM_ADS_ENABLED = YES
MEGRUM_AD_PLACEHOLDERS_ENABLED = NO
MEGRUM_AD_PROVIDER = admob
// Google Mobile Ads SDKはリンクされているだけで起動時にGADApplicationIdentifierを
// 検証し、空だとアプリが即クラッシュする。広告を無効にする時もGoogle公式の
// サンプルApp IDを入れておく（広告の表示可否はMEGRUM_ADS_ENABLED側で制御）。
MEGRUM_ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511
MEGRUM_ADMOB_TEST_ADS_ENABLED = YES
MEGRUM_ADMOB_TEST_BANNER_UNIT_ID =
MEGRUM_ADMOB_TEST_NATIVE_UNIT_ID =
MEGRUM_AD_PREVIEW_VIEWER_IDS =
// テスト中はGoogle公式デモユニットIDを設定（TEST_ADS_ENABLED=YESの間、リクエストは
// デモユニットへ差し替わる。空のままだと missingUnitID 扱いで広告枠ごと非表示になる）。
MEGRUM_ADMOB_HOME_BANNER_UNIT_ID = ca-app-pub-3940256099942544/2435281174
MEGRUM_ADMOB_WISH_BANNER_UNIT_ID = ca-app-pub-3940256099942544/2435281174
MEGRUM_ADMOB_SEARCH_BANNER_UNIT_ID = ca-app-pub-3940256099942544/2435281174
MEGRUM_ADMOB_SEARCH_NATIVE_UNIT_ID = ca-app-pub-3940256099942544/3986624511
MEGRUM_ADMOB_PROFILE_BANNER_UNIT_ID = ca-app-pub-3940256099942544/2435281174
MEGRUM_ADMOB_TRADES_BANNER_UNIT_ID = ca-app-pub-3940256099942544/2435281174
MEGRUM_ADMOB_BOARD_ROOM_BANNER_UNIT_ID = ca-app-pub-3940256099942544/2435281174
MEGRUM_ADMOB_HOME_INTERSTITIAL_UNIT_ID =
MEGRUM_ADMOB_WISH_INTERSTITIAL_UNIT_ID =
MEGRUM_ADMOB_SEARCH_INTERSTITIAL_UNIT_ID = ca-app-pub-8452629012277819/3070048280
MEGRUM_ADMOB_MEGURI_INTERSTITIAL_UNIT_ID =

#include? "MegrumNative.local.xcconfig"
